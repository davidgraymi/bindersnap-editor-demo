// feedback.bindersnap.com: the app's "Send feedback" dialog posts here, and an
// issue opens in the private feedback repository. /errors takes error reports
// from the app and the API, into the private errors repository. ADR 0006 is
// why this is a Worker and what it may never do. `.github/workflows/feedback-worker.yml`
// deploys it on every push to `main` that touches it; nothing else does.
//
// Secrets, set once by hand and never in this file (see README.md):
//   GITHUB_APP_ID, GITHUB_APP_PRIVATE_KEY, TURNSTILE_SECRET_KEY,
//   ERROR_REPORT_SECRET (the API's bearer for /errors)
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bindersnap-feedback",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "vars": {
    // Where the app is served from. The public site, bindersnap.com, has no
    // Send feedback button.
    "ALLOWED_ORIGINS": "https://app.bindersnap.com",
    "FEEDBACK_REPOSITORY": "davidgraymi/bindersnap-feedback",
    "ERRORS_REPOSITORY": "davidgraymi/bindersnap-errors",
  },
  // Five reports a minute from one address. The free plan's one WAF
  // rate-limit rule already guards sign-in, so this one lives in the Worker.
  // namespace_id is any number unique within the account.
  "ratelimits": [
    {
      "name": "FEEDBACK_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
    // Error reports from one address: the app sends ten a page at most.
    {
      "name": "ERROR_IP_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 },
    },
    // One write a minute per error, keyed "fp:<fingerprint>": a burst of the
    // same error becomes one comment, and GitHub's search index has time to
    // catch up before the next one looks for its issue.
    {
      "name": "ERROR_FINGERPRINT_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 1, "period": 60 },
    },
    // Every error write together. Each one searches, and GitHub allows 30
    // searches a minute.
    {
      "name": "ERROR_OVERALL_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  // Its log lines say what happened, never what anybody wrote.
  "observability": { "enabled": true },
  // Wrangler creates the proxied DNS record for a custom domain itself, so
  // infra/edge must not also manage this one.
  "routes": [{ "pattern": "feedback.bindersnap.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
}
