{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "start",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "up"
      ],
      "port": 5173
    },
    {
      "name": "app-dev",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "dev:app"
      ],
      "port": 5174,
      "autoPort": false,
      "env": {
        "PORT": "5174",
        "APP_PORT": "5174",
        "BUN_PUBLIC_API_BASE_URL": "http://localhost:8788",
        "BUN_PUBLIC_API_URL": "http://localhost:8788"
      }
    }
  ]
}
