{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun run test:*)",
      "Bash(bun test:*)",
      "Bash(bun run build)",
      "Bash(bun run format:*)",
      "Bash(bun run up)",
      "Bash(bun run up --fresh)",
      "Bash(bun run down)",
      "Bash(bun run stack status:*)",
      "Bash(bun run stack logs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh run view:*)"
    ],
    "deny": [
      "Bash(docker compose:*)",
      "Bash(docker-compose:*)",
      "Edit(/CHANGELOG.md)",
      "Edit(/bun.lock)",
      "Edit(/.env)",
      "Write(/CHANGELOG.md)",
      "Write(/bun.lock)",
      "Write(/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/guard-bash.ts\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/format-edited.ts\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "stripe@claude-plugins-official": true,
    "terraform@hashicorp": true,
    "a11y-audit@claude-code-skills": true,
    "aeo@claude-code-skills": true
  },
  "extraKnownMarketplaces": {
    "hashicorp": {
      "source": {
        "source": "github",
        "repo": "hashicorp/agent-skills"
      }
    },
    "claude-code-skills": {
      "source": {
        "source": "github",
        "repo": "alirezarezvani/claude-skills"
      }
    }
  }
}
