{
  "name": "bindersnap-editor-demo",
  "version": "0.4.71",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "bun run clean && bun build ./apps/app/index.html --outdir=dist --target=browser --minify --splitting --public-path=/ --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*' && cp dist/index.html dist/404.html",
    "changelog": "auto-changelog -p && git add CHANGELOG.md",
    "clean": "rm -rf dist",
    "db:generate": "bunx drizzle-kit generate",
    "db:check": "bunx drizzle-kit check",
    "debug": "bun run debug:app",
    "debug:app": "bun --inspect --hot server.ts",
    "debug:api": "bun --inspect --hot services/api/server.ts",
    "dev": "bun run dev:app",
    "dev:app": "bun --hot server.ts",
    "dev:api": "bun --hot services/api/server.ts",
    "down": "bun scripts/stack.ts down",
    "format": "bunx prettier --write \"**/*.{js,ts,jsx,tsx,html,css,json,yml,yaml,md}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "bunx prettier --check \"**/*.{js,ts,jsx,tsx,html,css,json,yml,yaml,md}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "generate:gitea-client": "bun run scripts/generate-gitea-api.ts",
    "generate:api-schema": "bun packages/api-schema/generate-openapi.ts",
    "generate:api-client": "bunx orval --config orval.config.ts",
    "generate:bff": "bun run generate:api-schema && bun run generate:api-client",
    "lighthouse": "bun run build && sh -c 'python3 -m http.server 4173 --directory dist >/dev/null 2>&1 & SERVER_PID=$!; sleep 1; bunx lighthouse http://localhost:4173 --output=json --output-path=./lighthouse.json --quiet --chrome-flags=\"--headless --no-sandbox --disable-gpu\" --no-enable-error-reporting; kill $SERVER_PID' && bun run summarize",
    "backfill:org-billing": "bun scripts/backfill-org-billing.ts",
    "reconcile:stripe-customer": "bun scripts/reconcile-stripe-customer.ts",
    "release": "standard-version",
    "serve": "bun run serve:app",
    "serve:app": "NODE_ENV=production bun server.ts",
    "serve:api": "NODE_ENV=production bun services/api/server.ts",
    "start": "bun run serve:app",
    "summarize": "bun scripts/summarize-lighthouse.ts",
    "test": "bun run test:all",
    "test:all": "bun run test:app && bun run test:ops && bun run test:seed",
    "test:app": "bun test apps/app packages/editor packages/utils packages/ui-tokens",
    "test:ops": "bun test services/api scripts infra/backups",
    "test:integration": "bunx playwright test --config=playwright.config.ts",
    "test:seed": "bun test tests/seed-scenario.test.ts tests/seed-documents.test.ts",
    "test:unit": "bun test",
    "up": "bun scripts/stack.ts up",
    "up:fg": "bun scripts/stack.ts up --fg",
    "up:fresh": "bun scripts/stack.ts up --fresh",
    "stack": "bun scripts/stack.ts",
    "tf:apply": "bash infra/apply-all.sh",
    "tf:bootstrap": "bash infra/bootstrap.sh",
    "tf:plan": "bash infra/apply-all.sh plan"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@floating-ui/dom": "^1.8.0",
    "@tiptap/extension-color": "^3.29.2",
    "@tiptap/extension-highlight": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/extension-subscript": "^3.29.2",
    "@tiptap/extension-superscript": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/extension-task-item": "^3.29.2",
    "@tiptap/extension-task-list": "^3.29.2",
    "@tiptap/extension-text-align": "^3.29.2",
    "@tiptap/extension-text-style": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@types/dompurify": "^3.2.0",
    "diff": "^8.0.4",
    "dompurify": "^3.4.13",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.574.0",
    "mammoth": "^1.12.1",
    "node-htmldiff": "^0.9.4",
    "openapi-fetch": "^0.17.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^22.4.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bun": "latest",
    "@types/diff": "^8.0.0",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/uuid": "^11.0.0",
    "auto-changelog": "^2.6.0",
    "docx": "^9.7.1",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "orval": "^8.23.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.6",
    "standard-version": "^9.5.0",
    "yaml": "^2.9.0"
  }
}
