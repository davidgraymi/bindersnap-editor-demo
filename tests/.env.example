# Copy this file to .env before `bun run up`, then fill in values.
# The seed script prints ALICE_TOKEN to stdout on first run.

# Stack identity and ports are NOT set here any more. The first stack command
# in a checkout (`bun run up`, `bun run down`, `bun run stack status`,
# `bun run test:integration`) claims a free port block for it and writes
# STACK_NAME plus the *_PORT variables into a managed block at the bottom of
# .env. Run `bun run stack status` to see what you were given. Copying a port
# block by hand is what used to put two worktrees on the same containers.

VITE_GITEA_TOKEN=
GITEA_ADMIN_USER=alice
GITEA_ADMIN_PASS=dev
BINDERSNAP_GITEA_TOKEN_SCOPES=read:repository

# These URLs are derived from the ports above by compose and by the test
# helpers. Uncomment one only to point at something other than the local stack
# — a value set here wins over the derived one and will not follow a port
# change.
# VITE_GITEA_URL=http://localhost:3000
# VITE_HOCUSPOCUS_URL=ws://localhost:1234
# BUN_PUBLIC_API_BASE_URL=http://localhost:8788
# GITEA_INTERNAL_URL=http://gitea:3000

# OAuth2 PKCE app — filled in automatically by seed script output.
# Client type: Public (no secret required for PKCE).
BUN_PUBLIC_GITEA_OAUTH_CLIENT_ID=
# Must match the APP_PORT in the managed stack block; the seed registers it.
BUN_PUBLIC_GITEA_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback

# Pandoc conversion service
BUN_PUBLIC_PANDOC_SERVICE_URL=http://localhost:3001

# Stripe test checkout / subscription paywall
STRIPE_SECRET_KEY=sk_test_...     # test-mode secret key from the Stripe Dashboard
STRIPE_WEBHOOK_SECRET=            # optional for Playwright; set this yourself for manual bun run up billing tests
STRIPE_PRICE_ID=price_...         # subscription price ID used by Checkout Sessions
