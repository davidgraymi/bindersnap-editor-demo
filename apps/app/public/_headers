# Response headers for app.bindersnap.com, the app, read by Cloudflare's
# static assets (apps/app/wrangler.jsonc). The public site, bindersnap.com,
# has its own (apps/site/public/_headers). index.html also carries a
# frame-busting script (#132) as a second line of defence.
#
# No Content-Security-Policy script-src yet: index.html sets the theme with an
# inline script, and the editor, Turnstile and the collaboration socket each
# need an entry, so a full policy wants its own change. frame-ancestors,
# object-src and base-uri cost nothing.
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-Robots-Tag: noindex, nofollow

# The fonts the sign-in page draws (its heading is Lora, the rest Geist),
# asked for with the page instead of after the script has drawn it. On the
# app's own pages only, `/` and `/-/...`, where no file is ever served:
# index.html's <link> hrefs are bundled, and these must stay at /fonts/.
/
  Link: </fonts/fonts.css>; rel=preload; as=style, </fonts/lora-latin-wght-normal.woff2>; rel=preload; as=font; type="font/woff2"; crossorigin, </fonts/geist-latin-wght-normal.woff2>; rel=preload; as=font; type="font/woff2"; crossorigin

/-/*
  Link: </fonts/fonts.css>; rel=preload; as=style, </fonts/lora-latin-wght-normal.woff2>; rel=preload; as=font; type="font/woff2"; crossorigin, </fonts/geist-latin-wght-normal.woff2>; rel=preload; as=font; type="font/woff2"; crossorigin

# Cloudflare's default is max-age=0, so a phone asks again for every file on
# every visit. The bundler writes everything it builds to /_assets/ under a
# name taken from its content (scripts/build.ts), so a new build gets new
# names and these can be kept for good.
/_assets/*
  Cache-Control: public, max-age=31536000, immutable

# The fonts keep their names from build to build, so a month, not forever.
/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
