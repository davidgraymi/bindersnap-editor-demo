// bindersnap.com: the public site — the landing page, the marketing pages,
// help and legal — served as static files by a Cloudflare Worker with no code
// of its own (an "assets-only" Worker). The app is another Worker, on
// app.bindersnap.com (apps/app/wrangler.jsonc). `.github/workflows/static-site.yml`
// builds both (scripts/build.ts) and deploys them on every push to `main`;
// nothing else deploys them.
//
// See docs/ops/production-architecture.md §2.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bindersnap-site",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist/site",
    // A path with no file gets 404.html, with a 404. That page forwards an
    // address that is not the site's, such as `/{org}/...` from before the
    // app moved, to the app; `_redirects` sends `/-/...` there with a 301.
    "not_found_handling": "404-page",
    // `/pricing` → `/pricing/`, the redirect GitHub Pages also made.
    "html_handling": "auto-trailing-slash",
  },
  // Wrangler creates the proxied DNS record for a custom domain itself, so
  // infra/edge must not also manage the apex record.
  "routes": [{ "pattern": "bindersnap.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
}
