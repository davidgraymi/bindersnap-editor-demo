#!/usr/bin/env bash
set -euo pipefail

APP_DIR="${APP_DIR:-/opt/bindersnap}"
ENV_FILE="${ENV_FILE:-${APP_DIR}/.env.prod}"
COMPOSE_FILE="${COMPOSE_FILE:-docker-compose.prod.yml}"
GHCR_LOGIN_CMD="${GHCR_LOGIN_CMD:-bindersnap-ghcr-login}"

# Config lands on the host via the pyinfra deploy (deploy/deploy.py); the old
# `config sync` from the retired S3 config bucket is gone (#306).

usage() {
  cat <<'EOF'
Usage:
  bindersnap stack validate
  bindersnap stack restart
EOF
}

stack_validate() {
  cd "${APP_DIR}"

  docker compose --env-file "${ENV_FILE}" -f "${COMPOSE_FILE}" config -q
}

stack_restart() {
  cd "${APP_DIR}"

  if command -v "${GHCR_LOGIN_CMD}" >/dev/null 2>&1; then
    "${GHCR_LOGIN_CMD}"
  fi

  docker compose --env-file "${ENV_FILE}" -f "${COMPOSE_FILE}" pull api
  docker compose --env-file "${ENV_FILE}" -f "${COMPOSE_FILE}" up -d --remove-orphans
  docker compose --env-file "${ENV_FILE}" -f "${COMPOSE_FILE}" up -d --force-recreate litestream
  docker compose --env-file "${ENV_FILE}" -f "${COMPOSE_FILE}" ps
}

main() {
  local group="${1:-}"
  local action="${2:-}"

  case "${group}:${action}" in
    stack:validate)
      stack_validate
      ;;
    stack:restart)
      stack_restart
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
