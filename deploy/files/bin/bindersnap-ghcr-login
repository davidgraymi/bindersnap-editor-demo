#!/usr/bin/env bash
# Log Docker in to GHCR when the env file carries a token, so the private API
# image can be pulled. Ported from infra/compute/user-data.sh.tftpl (epic #302).
# No token means public images — a clean no-op.
set -euo pipefail

ENV_FILE="${ENV_FILE:-/opt/bindersnap/.env.prod}"

if [ ! -f "${ENV_FILE}" ]; then
  echo "No env file yet — skipping GHCR login"
  exit 0
fi

GHCR_TOKEN="$(grep '^GHCR_TOKEN=' "${ENV_FILE}" | cut -d= -f2- || true)"
GHCR_USER="$(grep '^GHCR_USER=' "${ENV_FILE}" | cut -d= -f2- || true)"

if [ -z "${GHCR_TOKEN}" ]; then
  echo "No GHCR_TOKEN in env file — assuming public images"
  exit 0
fi

echo "${GHCR_TOKEN}" | docker login ghcr.io \
  -u "${GHCR_USER:-davidgraymi}" --password-stdin
