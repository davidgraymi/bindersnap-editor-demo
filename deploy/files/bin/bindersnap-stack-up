#!/usr/bin/env bash
# Bring the Docker Compose stack up, force-recreating only when this deploy
# actually changed the env file or a config file. Replaces the boot-time
# bindersnap-compose.service + bindersnap-refresh-and-restart.service from
# infra/compute/user-data.sh.tftpl (epic #302, phase #304); pyinfra now drives
# the change detection and signals it through the state-dir markers below.
set -euo pipefail

APP_DIR="${APP_DIR:-/opt/bindersnap}"
ENV_FILE="${ENV_FILE:-${APP_DIR}/.env.prod}"
COMPOSE_FILE="${COMPOSE_FILE:-docker-compose.prod.yml}"
STATE_DIR="${STATE_DIR:-/run/bindersnap}"

changed=0

# pyinfra drops these markers when an uploaded config file or the SSM-rendered
# env file actually changed this run (via `_if=op.did_change`). Either one means
# the stack must be force-recreated rather than just reconciled.
[ -f "${STATE_DIR}/config-changed" ] && changed=1
[ -f "${STATE_DIR}/env-changed" ] && changed=1

cd "${APP_DIR}"
docker compose --env-file "${ENV_FILE}" -f "${COMPOSE_FILE}" pull

if [ "${changed}" -eq 1 ]; then
  echo "Env or config changed — recreating the stack"
  docker compose --env-file "${ENV_FILE}" -f "${COMPOSE_FILE}" up -d --build --force-recreate
else
  echo "Env and config unchanged — reconciling without recreate"
  docker compose --env-file "${ENV_FILE}" -f "${COMPOSE_FILE}" up -d
fi

docker compose --env-file "${ENV_FILE}" -f "${COMPOSE_FILE}" ps
