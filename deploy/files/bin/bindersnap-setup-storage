#!/usr/bin/env bash
# Format + mount the EBS data volume and point Docker's data-root at it.
# Ported from infra/compute/user-data.sh.tftpl (epic #302, phase #304) and made
# idempotent so it is safe to run on every pyinfra deploy, not just first boot.
set -euo pipefail

DATA_LABEL="${DATA_LABEL:-bsnap-data}"
DATA_MOUNT="${DATA_MOUNT:-/data}"

# ---------- Locate the data device ----------
# The data EBS volume is attached by Terraform. On Nitro instances it appears as
# /dev/nvme?n1; we skip whichever disk currently backs the root filesystem.
DATA_DEVICE=""
for _ in $(seq 1 30); do
  for dev in /dev/nvme?n1; do
    [ -b "$dev" ] || continue
    ROOT_DISK="$(lsblk -ndo PKNAME "$(findmnt -n -o SOURCE /)" 2>/dev/null || true)"
    [ "$(basename "$dev")" = "$ROOT_DISK" ] && continue
    DATA_DEVICE="$dev"
    break
  done
  [ -n "$DATA_DEVICE" ] && break
  sleep 2
done

if [ -z "$DATA_DEVICE" ]; then
  echo "WARNING: EBS data volume not found — Docker will use the root volume" >&2
  exit 0
fi

# ---------- Format (first run only) + mount ----------
if ! blkid "$DATA_DEVICE" >/dev/null 2>&1; then
  mkfs.xfs -L "$DATA_LABEL" "$DATA_DEVICE"
fi

mkdir -p "$DATA_MOUNT"
if ! mountpoint -q "$DATA_MOUNT"; then
  mount LABEL="$DATA_LABEL" "$DATA_MOUNT"
fi

if ! grep -q "$DATA_LABEL" /etc/fstab; then
  echo "LABEL=$DATA_LABEL $DATA_MOUNT xfs defaults,nofail 0 2" >>/etc/fstab
fi

# ---------- Point Docker's data-root at the data volume ----------
# All named volumes (gitea-data, api-data, caddy-data) then live on persistent
# EBS. We only rewrite daemon.json + bounce Docker when the desired config is
# not already in place, so steady-state deploys never restart the daemon (and
# therefore never bounce the running stack).
mkdir -p "$DATA_MOUNT/docker" /etc/docker
DESIRED='{ "data-root": "/data/docker" }'

if [ "$(cat /etc/docker/daemon.json 2>/dev/null || true)" != "$DESIRED" ]; then
  printf '%s\n' "$DESIRED" >/etc/docker/daemon.json
  # Only restart if Docker is already running; on a fresh host the daemon has
  # not been started yet and pyinfra brings it up afterwards with this config.
  if systemctl is-active --quiet docker; then
    systemctl restart docker
  fi
fi
